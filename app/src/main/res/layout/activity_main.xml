<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".MainActivity">


    <androidx.cardview.widget.CardView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="24dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="16dp">

            <ImageView
                android:id="@+id/img_pet_photo"
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:src="@drawable/ic_pet_placeholder"
                android:contentDescription="@string/pet_photo"
                android:scaleType="centerCrop"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:id="@+id/tv_pet_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/pet_name"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="8dp"/>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

<!--    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/pet_management"
        android:textSize="24sp"
        android:layout_gravity="center_horizontal"
        android:paddingBottom="32dp"/>-->
<!-- this is where I stopped -->
    <Button
        android:id="@+id/btn_manage_type"
        android:layout_width="200dp"
        android:layout_height="wrap_content"
        android:text="@string/manage_types"
        android:layout_gravity="center_horizontal" />

    <Button
        android:id="@+id/btn_manage_breed"
        android:layout_width="200dp"
        android:layout_height="wrap_content"
        android:text="@string/manage_breeds"
        android:layout_gravity="center_horizontal" />

    <Button
        android:id="@+id/btn_manage_city"
        android:layout_width="200dp"
        android:layout_height="wrap_content"
        android:text="@string/manage_cities"
        android:layout_gravity="center_horizontal" />

    <Button
        android:id="@+id/btn_manage_animal"
        android:layout_width="200dp"
        android:layout_height="wrap_content"
        android:text="@string/manage_animals"
        android:layout_gravity="center_horizontal" />

    <Button
        android:id="@+id/btn_search"
        android:layout_width="200dp"
        android:layout_height="wrap_content"
        android:text="@string/search_animals"
        android:layout_gravity="center_horizontal" />

</LinearLayout>